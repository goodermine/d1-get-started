<canvas id="starfield" aria-hidden="true"></canvas>

<script>
  const c = document.getElementById("starfield") as HTMLCanvasElement;
  const ctx = c.getContext("2d")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let w = 0, h = 0, raf = 0, running = false;

  type Star = { x: number; y: number; z: number };
  let stars: Star[] = [];

  function resize() {
    const r = c.parentElement!.getBoundingClientRect();
    w = c.width = Math.floor(r.width);
    h = c.height = Math.floor(r.height);
    const n = Math.min(220, Math.floor((w * h) / 9000));
    stars = Array.from({ length: n }, () => ({
      x: Math.random() * w - w / 2,
      y: Math.random() * h - h / 2,
      z: Math.random() * w,
    }));
  }

  function frame() {
    ctx.fillStyle = "rgba(6,7,12,0.5)";
    ctx.fillRect(0, 0, w, h);
    for (const s of stars) {
      s.z -= 1.6;
      if (s.z <= 1) {
        s.x = Math.random() * w - w / 2;
        s.y = Math.random() * h - h / 2;
        s.z = w;
      }
      const k = 120 / s.z;
      const x = s.x * k + w / 2;
      const y = s.y * k + h / 2;
      if (x < 0 || x >= w || y < 0 || y >= h) continue;
      const size = Math.max(0.4, (1 - s.z / w) * 2.4);
      const t = 1 - s.z / w;
      ctx.fillStyle = `rgba(${Math.round(65 + t * 190)}, ${Math.round(
        234 - t * 80
      )}, ${Math.round(212 + t * 40)}, ${0.35 + t * 0.65})`;
      ctx.fillRect(x, y, size, size);
    }
    raf = requestAnimationFrame(frame);
  }

  function start() {
    if (running || reduce) return;
    running = true;
    raf = requestAnimationFrame(frame);
  }
  function stop() {
    running = false;
    cancelAnimationFrame(raf);
  }

  resize();
  addEventListener("resize", resize);

  if (reduce) {
    // Static scatter for reduced-motion users.
    ctx.fillStyle = "#41ead4";
    for (const s of stars) {
      const k = 120 / s.z;
      ctx.globalAlpha = 0.5;
      ctx.fillRect(s.x * k + w / 2, s.y * k + h / 2, 1.2, 1.2);
    }
    ctx.globalAlpha = 1;
  } else {
    // Only animate while the hero is on screen and the tab is visible.
    new IntersectionObserver(
      (e) => (e[0].isIntersecting ? start() : stop()),
      { threshold: 0.05 }
    ).observe(c);
    document.addEventListener("visibilitychange", () =>
      document.hidden ? stop() : start()
    );
  }
</script>

<style>
  #starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
