---
// WORDVADERS — a from-scratch Space-Invaders with synth audio, particle
// explosions, screen-shake, power-ups, and boss waves. No asset files: all
// sound is generated with WebAudio, all art is canvas primitives.
---
<div class="cabinet">
  <div class="bezel">
    <div class="marquee-row">
      <span class="title">WORDVADERS</span>
      <span class="hud">
        <span>SCORE <b id="iv-score">0</b></span>
        <span>HI <b id="iv-hi">0</b></span>
        <span>LIVES <b id="iv-lives">3</b></span>
        <button id="iv-mute" class="mute" aria-label="Toggle sound" title="Toggle sound">🔊</button>
      </span>
    </div>
    <div class="screen-wrap">
      <canvas id="iv-canvas" width="720" height="480" aria-label="WORDVADERS — a Space Invaders style arcade game. The invaders are letters."></canvas>
      <div class="overlay" id="iv-overlay">
        <p class="ov-title">WORDVADERS</p>
        <p class="ov-sub">The words are invading.<br />Implement them. Letter by letter.</p>
        <button class="btn btn-primary" id="iv-start">► INSERT COIN</button>
        <p class="ov-keys muted">← → move · SPACE fire · catch <b>R</b>/<b>S</b> power-ups<br />touch: buttons below</p>
      </div>
    </div>
    <div class="touch-controls" aria-hidden="false">
      <button class="tbtn" id="iv-left" aria-label="Move left">◀</button>
      <button class="tbtn fire" id="iv-fire" aria-label="Fire">⦿</button>
      <button class="tbtn" id="iv-right" aria-label="Move right">▶</button>
    </div>
  </div>
</div>

<script>
  const cv = document.getElementById("iv-canvas") as HTMLCanvasElement;
  const ctx = cv.getContext("2d")!;
  const overlay = document.getElementById("iv-overlay")!;
  const startBtn = document.getElementById("iv-start")!;
  const muteBtn = document.getElementById("iv-mute") as HTMLButtonElement;
  const elScore = document.getElementById("iv-score")!;
  const elHi = document.getElementById("iv-hi")!;
  const elLives = document.getElementById("iv-lives")!;

  const W = 720, H = 480;
  const WORDS = ["WONDER", "EXTREME", "FORGED", "SHIPPED", "PIXELS", "IMPLEMENT"];
  const BOSSWORDS = ["SYSTEM", "OVERLORD", "FINALE", "EXTREME"];
  const COLS = ["#41ead4", "#8b5cf6", "#ff3ec8", "#ffc24e"];

  // ---- Audio (synth, no files) ----
  const AC = (window.AudioContext || (window as any).webkitAudioContext);
  let actx: AudioContext | null = null;
  let muted = localStorage.getItem("wv-mute") === "1";
  muteBtn.textContent = muted ? "🔇" : "🔊";
  const ac = () => (actx ||= new AC());
  function tone(freq: number, dur: number, type: OscillatorType = "square", vol = 0.06, slideTo?: number) {
    if (muted || !actx) return;
    const c = actx, o = c.createOscillator(), g = c.createGain();
    o.type = type; o.frequency.setValueAtTime(freq, c.currentTime);
    if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, c.currentTime + dur);
    g.gain.setValueAtTime(vol, c.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001, c.currentTime + dur);
    o.connect(g); g.connect(c.destination); o.start(); o.stop(c.currentTime + dur);
  }
  function noise(dur: number, vol = 0.12) {
    if (muted || !actx) return;
    const c = actx, n = Math.floor(c.sampleRate * dur), buf = c.createBuffer(1, n, c.sampleRate), d = buf.getChannelData(0);
    for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / n, 2);
    const s = c.createBufferSource(); s.buffer = buf; const g = c.createGain(); g.gain.value = vol;
    s.connect(g); g.connect(c.destination); s.start();
  }
  const sfx = {
    shoot: () => tone(880, 0.07, "square", 0.04, 240),
    hit: () => tone(440, 0.06, "square", 0.05, 900),
    boom: () => noise(0.35, 0.14),
    hurt: () => tone(170, 0.3, "sawtooth", 0.12, 55),
    wave: () => { tone(523, 0.12, "triangle", 0.07); setTimeout(() => tone(784, 0.16, "triangle", 0.07), 120); },
    power: () => { tone(660, 0.1, "square", 0.07, 1320); setTimeout(() => tone(990, 0.12, "square", 0.07, 1980), 90); },
    over: () => tone(330, 0.5, "sawtooth", 0.11, 70),
  };
  muteBtn.addEventListener("click", () => {
    muted = !muted; localStorage.setItem("wv-mute", muted ? "1" : "0");
    muteBtn.textContent = muted ? "🔇" : "🔊";
  });

  // ---- State ----
  type Inv = { x: number; y: number; ch: string; alive: boolean; col: string };
  type Shot = { x: number; y: number; vy: number; vx: number };
  type Part = { x: number; y: number; vx: number; vy: number; life: number; c: string; size: number };
  type Pow = { x: number; y: number; type: "rapid" | "spread"; dead?: boolean };
  type Boss = { x: number; y: number; w: number; h: number; word: string; hp: number; maxhp: number; dir: number; t: number };

  let invs: Inv[] = [], shots: Shot[] = [], bombs: Shot[] = [], parts: Part[] = [], powerups: Pow[] = [];
  let boss: Boss | null = null;
  let px = W / 2; const pSpeed = 5.2;
  let dir = 1, speed = 0.45;
  let score = 0, lives = 3, wave = 0;
  let hi = Number(localStorage.getItem("wordvaders-hi") || 0);
  let playing = false, over = false, raf = 0, lastShot = 0, shake = 0;
  let powerType: "rapid" | "spread" | "" = "", powerUntil = 0;
  const keys: Record<string, boolean> = {};
  elHi.textContent = String(hi);

  const powerActive = () => performance.now() < powerUntil;

  function burst(x: number, y: number, color: string, n = 12, power = 1) {
    for (let i = 0; i < n; i++) {
      const a = Math.random() * 6.283, sp = Math.random() * 3 * power + 0.5;
      parts.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, life: 1, c: color, size: Math.random() * 2 + 1.5 });
    }
  }
  const addShake = (v: number) => { shake = Math.min(16, shake + v); };

  function spawnWave() {
    parts = []; powerups = []; bombs = []; shots = [];
    if (wave > 0 && (wave + 1) % 4 === 0) {
      const word = BOSSWORDS[((wave + 1) / 4 - 1) % BOSSWORDS.length];
      const hp = 50 + wave * 22;
      boss = { x: W / 2, y: 92, w: Math.min(W - 80, word.length * 42 + 50), h: 56, word, hp, maxhp: hp, dir: 1, t: 0 };
      invs = [];
    } else {
      boss = null;
      const word = WORDS[wave % WORDS.length];
      invs = [];
      const cols = word.length, rows = 4;
      const gx = Math.min(72, (W - 120) / cols);
      const ox = (W - gx * (cols - 1)) / 2;
      for (let r = 0; r < rows; r++)
        for (let c = 0; c < cols; c++)
          invs.push({ x: ox + c * gx, y: 64 + r * 46, ch: word[c], alive: true, col: COLS[r % COLS.length] });
      speed = 0.45 + wave * 0.12;
    }
  }

  function reset() {
    score = 0; lives = 3; wave = 0; px = W / 2;
    powerType = ""; powerUntil = 0; over = false;
    spawnWave(); sync();
  }
  function sync() {
    elScore.textContent = String(score);
    elLives.textContent = String(lives);
    elHi.textContent = String(hi);
  }

  function fire() {
    const now = performance.now();
    const cd = powerActive() && powerType === "rapid" ? 110 : 240;
    if (now - lastShot < cd) return;
    lastShot = now;
    if (powerActive() && powerType === "spread") {
      shots.push({ x: px, y: H - 58, vy: -8.5, vx: 0 });
      shots.push({ x: px, y: H - 58, vy: -8.2, vx: -2.3 });
      shots.push({ x: px, y: H - 58, vy: -8.2, vx: 2.3 });
    } else {
      shots.push({ x: px, y: H - 58, vy: -8.5, vx: 0 });
    }
    sfx.shoot();
  }

  function killInvader(i: Inv) {
    i.alive = false;
    burst(i.x, i.y, i.col, 12);
    score += 10 + wave * 5;
    if (score > hi) { hi = score; localStorage.setItem("wordvaders-hi", String(hi)); }
    sfx.hit();
    if (Math.random() < 0.08) powerups.push({ x: i.x, y: i.y, type: Math.random() < 0.5 ? "rapid" : "spread" });
    sync();
  }

  function update() {
    if (keys.ArrowLeft || keys.a) px -= pSpeed;
    if (keys.ArrowRight || keys.d) px += pSpeed;
    px = Math.max(26, Math.min(W - 26, px));
    if (keys[" "] || keys.Spacebar) fire();

    for (const s of shots) { s.y += s.vy; s.x += s.vx; }
    for (const b of bombs) { b.y += b.vy; b.x += b.vx; }
    for (const p of parts) { p.x += p.vx; p.y += p.vy; p.vy += 0.05; p.life -= 0.03; }
    for (const pu of powerups) pu.y += 1.7;
    parts = parts.filter((p) => p.life > 0);
    shots = shots.filter((s) => s.y > -10 && s.x > -10 && s.x < W + 10);
    bombs = bombs.filter((b) => b.y < H + 10);

    if (boss) {
      boss.t++;
      boss.x += boss.dir * (1.4 + wave * 0.08);
      if (boss.x > W - boss.w / 2 - 8 || boss.x < boss.w / 2 + 8) boss.dir *= -1;
      if (boss.t % Math.max(16, 44 - wave * 2) === 0)
        for (let k = -1; k <= 1; k++) bombs.push({ x: boss.x + k * 36, y: boss.y + boss.h / 2, vy: 3.4, vx: k * 0.6 });
      for (const s of shots) {
        if (Math.abs(s.x - boss.x) < boss.w / 2 && Math.abs(s.y - boss.y) < boss.h / 2) {
          s.y = -99; boss.hp--; burst(s.x, boss.y + boss.h / 2, "#ff3ec8", 4); sfx.hit(); addShake(0.6);
          if (boss.hp <= 0) {
            burst(boss.x, boss.y, "#ffc24e", 60, 2.4); sfx.boom(); addShake(14);
            score += 200 + wave * 50; if (score > hi) { hi = score; localStorage.setItem("wordvaders-hi", String(hi)); }
            boss = null; wave++; sfx.wave(); spawnWave(); sync(); break;
          }
        }
      }
    } else {
      const alive = invs.filter((i) => i.alive);
      let edge = false;
      const sp = speed * (1 + (1 - alive.length / Math.max(1, invs.length)) * 1.7);
      for (const i of alive) { i.x += dir * sp; if (i.x > W - 34 || i.x < 34) edge = true; }
      if (edge) { dir *= -1; for (const i of alive) i.y += 16; }
      if (alive.length && Math.random() < 0.012 + wave * 0.002) {
        const sh = alive[(Math.random() * alive.length) | 0];
        bombs.push({ x: sh.x, y: sh.y + 14, vy: 3 + wave * 0.3, vx: 0 });
      }
      for (const s of shots) {
        for (const i of invs) {
          if (i.alive && Math.abs(s.x - i.x) < 18 && Math.abs(s.y - i.y) < 16) { s.y = -99; killInvader(i); break; }
        }
      }
      for (const i of alive) if (i.y > H - 90) over = true;
      if (!alive.length) { wave++; sfx.wave(); spawnWave(); }
    }

    // bombs hitting player
    for (const b of bombs) {
      if (Math.abs(b.x - px) < 20 && b.y > H - 64 && b.y < H - 30) {
        b.y = H + 99; lives--; addShake(10); burst(px, H - 46, "#ff5f57", 18, 1.4); sfx.hurt(); sync();
        if (lives <= 0) { over = true; sfx.over(); }
      }
    }
    // catch power-ups
    for (const pu of powerups) {
      if (pu.y > H - 64 && pu.y < H - 26 && Math.abs(pu.x - px) < 28) {
        pu.dead = true; powerType = pu.type; powerUntil = performance.now() + 6500; sfx.power(); burst(pu.x, pu.y, "#41ead4", 14);
      }
    }
    powerups = powerups.filter((pu) => !pu.dead && pu.y < H + 20);
  }

  function draw() {
    ctx.fillStyle = "#06070c";
    ctx.fillRect(0, 0, W, H);

    ctx.save();
    if (shake > 0) { ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake); shake *= 0.88; if (shake < 0.4) shake = 0; }

    ctx.strokeStyle = "#1d2235";
    ctx.beginPath(); ctx.moveTo(0, H - 28); ctx.lineTo(W, H - 28); ctx.stroke();

    // invaders
    ctx.font = "700 26px 'Space Grotesk Variable', monospace";
    ctx.textAlign = "center"; ctx.textBaseline = "middle";
    for (const i of invs) { if (!i.alive) continue; ctx.fillStyle = i.col; ctx.fillText(i.ch, i.x, i.y); }

    // boss
    if (boss) {
      const g = ctx.createLinearGradient(boss.x - boss.w / 2, 0, boss.x + boss.w / 2, 0);
      g.addColorStop(0, "#8b5cf6"); g.addColorStop(1, "#ff3ec8");
      ctx.fillStyle = g;
      ctx.fillRect(boss.x - boss.w / 2, boss.y - boss.h / 2, boss.w, boss.h);
      ctx.fillStyle = "#06070c"; ctx.font = "700 30px 'Space Grotesk Variable', monospace";
      ctx.fillText(boss.word, boss.x, boss.y + 2);
      // hp bar
      const bw = boss.w, hpf = Math.max(0, boss.hp / boss.maxhp);
      ctx.fillStyle = "#1d2235"; ctx.fillRect(boss.x - bw / 2, boss.y - boss.h / 2 - 12, bw, 6);
      ctx.fillStyle = "#41ead4"; ctx.fillRect(boss.x - bw / 2, boss.y - boss.h / 2 - 12, bw * hpf, 6);
    }

    // player ship
    ctx.fillStyle = powerActive() ? "#ffc24e" : "#41ead4";
    ctx.beginPath(); ctx.moveTo(px, H - 60); ctx.lineTo(px - 18, H - 34); ctx.lineTo(px + 18, H - 34); ctx.closePath(); ctx.fill();

    // shots / bombs
    ctx.fillStyle = "#e9edf9"; for (const s of shots) ctx.fillRect(s.x - 1.5, s.y - 7, 3, 12);
    ctx.fillStyle = "#ff3ec8"; for (const b of bombs) ctx.fillRect(b.x - 2, b.y - 6, 4, 10);

    // power-ups
    ctx.font = "700 16px 'Space Grotesk Variable', monospace";
    for (const pu of powerups) {
      ctx.fillStyle = pu.type === "rapid" ? "#41ead4" : "#ffc24e";
      ctx.beginPath(); ctx.arc(pu.x, pu.y, 11, 0, 6.283); ctx.fill();
      ctx.fillStyle = "#06070c"; ctx.fillText(pu.type === "rapid" ? "R" : "S", pu.x, pu.y + 1);
    }

    // particles
    for (const p of parts) { ctx.globalAlpha = Math.max(0, p.life); ctx.fillStyle = p.c; ctx.fillRect(p.x, p.y, p.size, p.size); }
    ctx.globalAlpha = 1;

    ctx.restore();

    // power-up timer banner (no shake)
    if (powerActive()) {
      ctx.fillStyle = powerType === "rapid" ? "#41ead4" : "#ffc24e";
      ctx.font = "700 13px 'Space Grotesk Variable', monospace";
      ctx.textAlign = "left";
      ctx.fillText((powerType === "rapid" ? "⚡ RAPID FIRE" : "✦ SPREAD SHOT") + " " + Math.ceil((powerUntil - performance.now()) / 1000) + "s", 12, 18);
      ctx.textAlign = "center";
    }

    if (over) {
      ctx.fillStyle = "rgba(6,7,12,0.8)"; ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = "#ff3ec8"; ctx.font = "700 44px 'Space Grotesk Variable', monospace";
      ctx.fillText("GAME OVER", W / 2, H / 2 - 26);
      ctx.fillStyle = "#e9edf9"; ctx.font = "600 20px 'Space Grotesk Variable', monospace";
      ctx.fillText(`SCORE ${score}  ·  HI ${hi}  ·  WAVE ${wave + 1}`, W / 2, H / 2 + 16);
      ctx.fillStyle = "#8d95ab"; ctx.fillText("press SPACE or ► to play again", W / 2, H / 2 + 52);
    }
  }

  function loop() { if (!playing) return; if (!over) update(); draw(); raf = requestAnimationFrame(loop); }
  function begin() {
    try { ac().resume(); } catch {}
    overlay.style.display = "none"; reset(); playing = true; cancelAnimationFrame(raf); loop(); cv.focus();
  }
  startBtn.addEventListener("click", begin);

  addEventListener("keydown", (e) => {
    if (["ArrowLeft", "ArrowRight", " "].includes(e.key) && playing) e.preventDefault();
    keys[e.key] = true;
    if ((e.key === " " || e.key === "Spacebar") && playing && !over) fire();
    if (over && (e.key === " " || e.key === "Enter")) begin();
  });
  addEventListener("keyup", (e) => (keys[e.key] = false));

  const hold = (id: string, key: string) => {
    const el = document.getElementById(id)!;
    const on = (e: Event) => { e.preventDefault(); keys[key] = true; if (over) begin(); };
    const off = (e: Event) => { e.preventDefault(); keys[key] = false; };
    el.addEventListener("touchstart", on, { passive: false });
    el.addEventListener("touchend", off);
    el.addEventListener("mousedown", on);
    el.addEventListener("mouseup", off);
    el.addEventListener("mouseleave", off);
  };
  hold("iv-left", "ArrowLeft");
  hold("iv-right", "ArrowRight");
  hold("iv-fire", " ");

  new IntersectionObserver((e) => {
    if (!e[0].isIntersecting) { playing = false; cancelAnimationFrame(raf); }
    else if (overlay.style.display === "none" && !playing) { playing = true; loop(); }
  }, { threshold: 0.05 }).observe(cv);
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) { playing = false; cancelAnimationFrame(raf); }
    else if (overlay.style.display === "none") { playing = true; loop(); }
  });

  ctx.fillStyle = "#06070c"; ctx.fillRect(0, 0, W, H);
</script>

<style>
  .cabinet {
    background: linear-gradient(180deg, #111422, #0a0c14);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(0.8rem, 2.5vw, 1.6rem);
    box-shadow: 0 0 60px color-mix(in srgb, var(--violet) 18%, transparent);
  }
  .marquee-row {
    display: flex; justify-content: space-between; align-items: center;
    gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-2);
    font-family: var(--font-mono);
  }
  .title {
    font-weight: 700; letter-spacing: 0.34em;
    background: linear-gradient(92deg, var(--cyan), var(--magenta));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hud { display: flex; gap: var(--space-4); align-items: center; font-size: var(--fs-sm); color: var(--muted); }
  .hud b { color: var(--text); }
  .mute { background: none; border: none; cursor: pointer; font-size: 1.1rem; padding: 0; line-height: 1; }
  .screen-wrap { position: relative; }
  #iv-canvas {
    width: 100%; height: auto; display: block;
    border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg);
  }
  .overlay {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: var(--space-2); text-align: center;
    background: radial-gradient(ellipse at 50% 40%, color-mix(in srgb, var(--violet) 18%, transparent), rgba(6, 7, 12, 0.88));
    border-radius: var(--radius-sm); padding: var(--space-4);
  }
  .ov-title { font-family: var(--font-mono); font-size: var(--fs-xl); font-weight: 700; letter-spacing: 0.4em; margin: 0; }
  .ov-sub { margin: 0 0 var(--space-3); color: var(--muted); }
  .ov-keys { font-size: var(--fs-sm); margin: var(--space-3) 0 0; font-family: var(--font-mono); }
  .ov-keys b { color: var(--cyan); }
  .touch-controls { display: none; justify-content: center; gap: var(--space-4); margin-top: var(--space-3); }
  .tbtn {
    font: inherit; font-size: 1.4rem; width: 64px; height: 52px;
    border-radius: var(--radius-sm); border: 1px solid var(--border);
    background: var(--surface); color: var(--text); touch-action: none;
  }
  .tbtn:active { border-color: var(--cyan); color: var(--cyan); }
  .fire { border-color: color-mix(in srgb, var(--magenta) 60%, var(--border)); }
  @media (pointer: coarse) { .touch-controls { display: flex; } }
</style>
