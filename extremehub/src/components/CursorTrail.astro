---
// Lightweight cursor particle trail. Fine-pointer + motion-OK only, so it
// never runs on touch devices or for reduced-motion users.
---
<canvas id="trail" aria-hidden="true"></canvas>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(pointer: fine)").matches;
  const canvas = document.getElementById("trail") as HTMLCanvasElement;

  if (fine && !reduce) {
    const ctx = canvas.getContext("2d")!;
    let w = 0, h = 0;
    const resize = () => { w = canvas.width = innerWidth; h = canvas.height = innerHeight; };
    resize();
    addEventListener("resize", resize);

    const COLORS = ["#41ead4", "#8b5cf6", "#ff3ec8"];
    type P = { x: number; y: number; vx: number; vy: number; life: number; c: string };
    let parts: P[] = [];
    let lastX = 0, lastY = 0, moved = false;

    addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      lastX = e.clientX; lastY = e.clientY; moved = true;
      const speed = Math.min(6, Math.hypot(e.movementX, e.movementY) * 0.4);
      const n = 1 + (speed | 0);
      for (let i = 0; i < n; i++) {
        parts.push({
          x: lastX, y: lastY,
          vx: (Math.random() - 0.5) * 1.2,
          vy: (Math.random() - 0.5) * 1.2 + 0.3,
          life: 1,
          c: COLORS[(Math.random() * COLORS.length) | 0],
        });
      }
      if (parts.length > 240) parts.splice(0, parts.length - 240);
    }, { passive: true });

    let raf = 0;
    const loop = () => {
      ctx.clearRect(0, 0, w, h);
      for (const p of parts) {
        p.x += p.vx; p.y += p.vy; p.life -= 0.03;
        ctx.globalAlpha = Math.max(0, p.life);
        ctx.fillStyle = p.c;
        ctx.fillRect(p.x, p.y, 2.5, 2.5);
      }
      ctx.globalAlpha = 1;
      parts = parts.filter((p) => p.life > 0);
      raf = requestAnimationFrame(loop);
    };
    const start = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(loop); };
    const stop = () => cancelAnimationFrame(raf);
    start();
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
  }
</script>

<style>
  #trail {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
  }
</style>
