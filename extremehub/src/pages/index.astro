---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShaderBg from "../components/ShaderBg.astro";
import CursorTrail from "../components/CursorTrail.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import KonamiEgg from "../components/KonamiEgg.astro";
import WordWonder from "../components/WordWonder.astro";
import Invaders from "../components/Invaders.astro";
import MiniCabinet from "../components/MiniCabinet.astro";

const proofs = [
  { h: "Hand-built, no bloat", p: "No frameworks shipped to your browser. Every effect on this page is a few kilobytes of hand-written code." },
  { h: "Plays everywhere", p: "Phone, tablet, desktop — keyboard or thumbs. Animations pause when off-screen to save your battery." },
  { h: "Wonder on demand", p: "Type a word and watch a few thousand particles implement it. That's the tagline, running live." },
  { h: "A real arcade", p: "WORDVADERS is a complete game — waves, lives, hi-scores saved on your machine. Built from scratch." },
  { h: "Respectful by default", p: "Reduced-motion users get a calm page. No-JS users still get every word. No trackers, no cookies." },
  { h: "Static & unbreakable", p: "The whole site compiles to plain files. No database, no server code, nothing to hack or patch." },
];

const terminal = [
  { c: "$ idea --raw \"an extreme hub\"", o: "parsing… ambition detected" },
  { c: "$ words --become wonder", o: "✓ particle engine online" },
  { c: "$ wonder --become implemented", o: "✓ arcade compiled · 0 frameworks · 11 KB of game" },
  { c: "$ ship it", o: "✓ deployed as plain static files — nothing to break" },
];
---

<BaseLayout>
  <CursorTrail />
  <ThemeSwitcher />
  <KonamiEgg />

  <!-- HERO -->
  <section class="hero">
    <ShaderBg />
    <div class="container hero-inner">
      <span class="eyebrow">/// aaron's extreme hub ///</span>
      <h1>
        Where words become <span class="neon">wonder</span>.<br />
        And wonder becomes <span class="neon">implemented</span>.
      </h1>
      <p class="hero-sub muted">
        A demonstration pushed to the edge on purpose — interactive art, a
        playable arcade, zero bloat. Everything you see was typed into
        existence.
      </p>
      <div class="hero-cta">
        <a href="#arcade" class="btn btn-primary">► Play WORDVADERS</a>
        <a href="#wonder" class="btn btn-ghost">Make a wonder</a>
        <a href="/dimension/" class="btn btn-ghost dim-cta">✦ Enter the Dimension</a>
      </div>
      <a href="#wonder" class="scroll-hint muted" aria-hidden="true">▼</a>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {Array.from({ length: 2 }).map(() => (
        <span>
          WORDS → WONDER → IMPLEMENTED ✦ TYPE IT ✦ PLAY IT ✦ SHIP IT ✦&nbsp;
        </span>
      ))}
    </div>
  </div>

  <!-- WORD WONDER -->
  <section class="section" id="wonder">
    <div class="container">
      <span class="eyebrow">exhibit 01 — the tagline, running live</span>
      <h2>Type a word. Watch it become wonder.</h2>
      <p class="muted lead">
        A few thousand particles scatter, hunt, and settle into whatever you
        give them. Words → wonder, literally.
      </p>
      <WordWonder />
    </div>
  </section>

  <!-- ARCADE -->
  <section class="section arcade" id="arcade">
    <div class="container">
      <span class="eyebrow">exhibit 02 — the arcade</span>
      <h2>The words are invading. <span class="neon">Implement them.</span></h2>
      <p class="muted lead">
        A complete Space-Invaders-style game, built from scratch for this page.
        The invaders are letters. The hi-score is yours to lose.
      </p>
      <Invaders />
    </div>
  </section>

  <!-- MINI-CABINET -->
  <section class="section minicab">
    <div class="container">
      <span class="eyebrow">exhibit 02½ — insert another coin</span>
      <h2>The <span class="neon">Mini-Cabinet</span>.</h2>
      <p class="muted lead">
        Three more from-scratch games — Snake, Wordbreaker, Ponger. Each one's
        code only downloads the moment you pick it, so the page stays as quick
        as ever.
      </p>
      <MiniCabinet />
    </div>
  </section>

  <!-- IMPLEMENTED / TERMINAL -->
  <section class="section" id="implemented">
    <div class="container impl-grid">
      <div>
        <span class="eyebrow">exhibit 03 — the receipts</span>
        <h2>"Extreme" doesn't have to mean heavy.</h2>
        <p class="muted">
          The whole hub — starfield, particle engine, full arcade game,
          design system — ships as plain static files with no runtime
          framework. It loads fast on a phone on bad hotel wi-fi, which is
          where websites go to die.
        </p>
        <div class="stats">
          <div class="stat"><b>0</b><span class="muted">frameworks shipped</span></div>
          <div class="stat"><b>1</b><span class="muted">page, fully static</span></div>
          <div class="stat"><b>&lt;20KB</b><span class="muted">of hand-written code</span></div>
          <div class="stat"><b>100%</b><span class="muted">works without cookies or trackers</span></div>
        </div>
      </div>
      <div class="term card" role="img" aria-label="A terminal showing the site being built and shipped">
        <div class="term-head">
          <i></i><i></i><i></i>
          <span class="muted">aaron@extremehub:~</span>
        </div>
        {terminal.map((t) => (
          <div class="term-line">
            <code class="cmd">{t.c}</code>
            <code class="out muted">{t.o}</code>
          </div>
        ))}
        <code class="cursor">▮</code>
      </div>
    </div>
  </section>

  <!-- WHAT THIS PROVES -->
  <section class="section proves">
    <div class="container">
      <span class="eyebrow">why this exists</span>
      <h2>What this page proves</h2>
      <div class="proof-grid">
        {proofs.map((p) => (
          <div class="card proof">
            <h3>{p.h}</h3>
            <p class="muted">{p.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE DIMENSION PORTAL -->
  <section class="section portal">
    <div class="container portal-inner">
      <span class="eyebrow">the final exhibit</span>
      <h2>Enter the <span class="neon">Dimension</span>.</h2>
      <p class="muted">
        A 60,000-particle journey through one canvas. Scrolling becomes flying.
        Words become galaxies. Headphones recommended.
      </p>
      <a href="/dimension/" class="btn btn-primary">✦ Enter the Dimension</a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="container foot-inner">
      <p class="foot-title">AARON'S <span class="neon">EXTREME</span> HUB</p>
      <p class="muted">Where words become wonder — and wonder becomes implemented.</p>
      <p class="muted small">
        Want one of these for yourself?
        <a href="mailto:completestrength@gmail.com?subject=Build%20me%20a%20wonder">Say the word.</a>
      </p>
      <p class="muted tiny">© {new Date().getFullYear()} Aaron Ellis · built by hand, shipped as static files · no cookies, no trackers</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .hero-inner { position: relative; text-align: center; max-width: 56rem; }
  .hero h1 { margin-bottom: var(--space-4); }
  .hero-sub { max-width: 36rem; margin-inline: auto; font-size: var(--fs-lg); margin-bottom: var(--space-5); }
  .hero-cta { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; }
  .scroll-hint {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: -12svh;
    font-size: 1.2rem;
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob { 50% { transform: translateX(-50%) translateY(8px); } }

  /* MARQUEE */
  .marquee {
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
    padding-block: 0.65rem;
  }
  .marquee-track {
    display: flex;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    letter-spacing: 0.22em;
    color: var(--muted);
    animation: slide 26s linear infinite;
    width: max-content;
  }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .scroll-hint { animation: none; }
  }

  .lead { max-width: 40rem; font-size: var(--fs-lg); margin-bottom: var(--space-5); }

  /* ARCADE */
  .arcade {
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, color-mix(in srgb, var(--violet) 14%, transparent), transparent 65%),
      var(--bg-2);
    border-block: 1px solid var(--border);
  }

  .minicab { border-bottom: 1px solid var(--border); }

  /* IMPLEMENTED */
  .impl-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: var(--space-6);
    align-items: center;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .stat {
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .stat b { font-size: var(--fs-xl); color: var(--cyan); }
  .stat span { font-size: var(--fs-sm); }
  .term { font-family: var(--font-mono); font-size: var(--fs-sm); padding: var(--space-4); }
  .term-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-3);
  }
  .term-head i {
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--border);
  }
  .term-head i:nth-child(1) { background: #ff5f57; }
  .term-head i:nth-child(2) { background: #febc2e; }
  .term-head i:nth-child(3) { background: #28c840; }
  .term-head span { margin-left: auto; font-size: 0.75rem; }
  .term-line { display: grid; gap: 0.15rem; margin-bottom: var(--space-3); }
  .cmd { color: var(--cyan); }
  .out::before { content: "  "; }
  .cursor { color: var(--magenta); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

  /* PROOFS */
  .proves { background: var(--bg-2); border-top: 1px solid var(--border); }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .proof h3 { font-size: var(--fs-lg); }
  .proof p { margin: 0; font-size: var(--fs-sm); }

  /* PORTAL */
  .portal {
    background:
      radial-gradient(ellipse 60% 80% at 50% 100%, color-mix(in srgb, var(--magenta) 13%, transparent), transparent 65%),
      var(--bg-2);
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .portal-inner { max-width: 40rem; margin-inline: auto; }
  .portal .btn { margin-top: var(--space-3); }
  .dim-cta { border-color: color-mix(in srgb, var(--magenta) 50%, var(--border)); }

  /* FOOTER */
  .foot {
    border-top: 1px solid var(--border);
    padding-block: var(--space-6);
    text-align: center;
  }
  .foot-title {
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.3em;
    font-size: var(--fs-lg);
    margin-bottom: var(--space-2);
  }
  .small { font-size: var(--fs-sm); }
  .tiny { font-size: 0.78rem; margin-top: var(--space-4); }

  @media (max-width: 860px) {
    .impl-grid { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
