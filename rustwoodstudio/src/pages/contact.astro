---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site.ts";
---

<BaseLayout title="Contact" description="Get in touch with Rustwood Studio.">
  <PageHeader
    eyebrow="Say Hello"
    title="Contact"
    lead="Questions about coaching, a custom song, VOX, or anything Rustwood — send a note."
  />

  <section class="section">
    <div class="container contact-grid">
      <ContactForm />
      <aside class="aside">
        <h2>Prefer email?</h2>
        <p class="muted">Reach me directly any time:</p>
        <a href={`mailto:${site.email}`} class="email">{site.email}</a>
        <p class="muted client">
          Already a client? <a href={site.appUrl}>Client Login →</a>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  .aside h2 { font-size: var(--fs-xl); }
  .email {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    color: var(--color-ember);
    margin: var(--space-2) 0 var(--space-4);
    word-break: break-all;
  }
  .client { font-size: var(--fs-sm); }
  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
