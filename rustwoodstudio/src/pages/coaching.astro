---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import EmailCapture from "../components/EmailCapture.astro";
import { site } from "../data/site.ts";

const areas = [
  { h: "Vocal confidence", p: "Singing in front of people without your throat closing on you." },
  { h: "Performance nerves", p: "Practical tools for the moments before and during a performance." },
  { h: "Singing fundamentals", p: "The foundations, taught properly — breath, posture, phrasing, practice." },
  { h: "Microphone technique", p: "Working with the mic instead of fighting it." },
  { h: "Stage confidence", p: "Owning the space, not surviving it." },
  { h: "Creative performance", p: "Bringing your material to life as a performer, not just a singer." },
  { h: "AI-assisted practice systems", p: "Using VOX and structured feedback loops to make practice count." },
];
---

<BaseLayout
  title="Coaching"
  description="Vocal and performance coaching with Aaron Ellis — vocal confidence, performance nerves, fundamentals, microphone and stage technique, and AI-assisted practice systems."
>
  <PageHeader
    eyebrow="Work With Aaron"
    title="Voice is not just sound."
    lead="It's confidence, body, rhythm, emotion, attention, and practice. Coaching at Rustwood Studio works on all of it — not just the notes."
  />

  <section class="section">
    <div class="container about-grid">
      <div>
        <span class="eyebrow">The Coach</span>
        <h2>Aaron Ellis</h2>
        <p>
          Aaron brings together decades of martial arts, coaching,
          hypnotherapy, performance, singing, and AI systems work.
        </p>
        <p class="muted">
          That mix matters. Vocal problems are rarely just vocal — they're
          tension, attention, nerves, and habit. Coaching that only addresses
          the sound usually doesn't hold. Coaching that addresses the person
          does.
        </p>
      </div>
      <div class="card quote">
        <p class="q-text">
          “Capability is forged through practice, feedback, and the right
          systems. Coaching is where all three meet.”
        </p>
        <span class="muted">— Aaron Ellis</span>
      </div>
    </div>
  </section>

  <section class="section areas-s">
    <div class="container">
      <h2>What coaching can include</h2>
      <div class="areas">
        {areas.map((a) => (
          <div class="card area">
            <h3>{a.h}</h3>
            <p class="muted">{a.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-block card">
      <span class="eyebrow">Enquire</span>
      <h2>Tell me where you're at.</h2>
      <p class="muted">
        A few lines about your voice, your goals, and what's getting in the way
        is the perfect starting point.
      </p>
      <a
        href={`mailto:${site.email}?subject=${encodeURIComponent("Coaching enquiry")}`}
        class="btn btn-primary"
      >
        Enquire About Coaching
      </a>
    </div>
  </section>

  <EmailCapture />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-6);
    align-items: center;
  }
  .quote { border-left: 3px solid var(--color-copper); }
  .q-text {
    font-family: var(--font-heading);
    font-size: var(--fs-xl);
    line-height: 1.3;
    color: var(--color-ember);
  }
  .areas-s { background: var(--color-bg-2); border-block: 1px solid var(--color-border); }
  .areas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .areas h3 { font-size: var(--fs-lg); }
  .areas p { margin: 0; font-size: var(--fs-sm); }
  .cta-block { text-align: center; max-width: 40rem; margin-inline: auto; }
  .cta-block .btn { margin-top: var(--space-3); }
  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
