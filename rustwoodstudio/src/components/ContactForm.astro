---
// Contact form that posts to Formspree via fetch (no page reload).
// If the endpoint hasn't been configured yet, it gracefully falls back to
// opening a pre-filled email so the form is never a dead end.
import { site } from "../data/site.ts";
const configured = !site.formEndpoint.includes("YOUR_FORM_ID");
---

<form
  id="contact-form"
  class="card contact-form"
  action={site.formEndpoint}
  method="POST"
  data-configured={configured ? "true" : "false"}
  data-email={site.email}
>
  <div class="row">
    <div class="field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  <div class="field">
    <label for="cf-subject">What's this about?</label>
    <select id="cf-subject" name="subject">
      <option>Coaching enquiry</option>
      <option>Custom song — Creative Brief</option>
      <option>VOX / tools</option>
      <option>Singing Fundamentals</option>
      <option>Something else</option>
    </select>
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="5" required
      placeholder="A few lines about where you're at and what you're after."></textarea>
  </div>

  <!-- Honeypot: bots fill this; humans don't. -->
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="gotcha" aria-hidden="true" />

  <div class="form-foot">
    <button type="submit" class="btn btn-primary">Send message</button>
    <p class="form-status muted" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector(".form-status") as HTMLElement;
    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    const configured = form.dataset.configured === "true";
    const email = form.dataset.email || "";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);

      // Fallback before Formspree is wired up: open a pre-filled email.
      if (!configured) {
        const subject = encodeURIComponent(String(data.get("subject") || "Enquiry"));
        const body = encodeURIComponent(
          `Name: ${data.get("name")}\nEmail: ${data.get("email")}\n\n${data.get("message")}`,
        );
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        return;
      }

      btn.disabled = true;
      status.textContent = "Sending…";
      status.style.color = "";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          form.reset();
          status.textContent = "Thanks — your message is on its way. I'll be in touch.";
          status.style.color = "var(--color-ember)";
        } else {
          throw new Error("Bad response");
        }
      } catch {
        status.textContent = `Something went wrong. Please email ${email} directly.`;
        status.style.color = "#e08a8a";
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-form { display: grid; gap: var(--space-4); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .field { display: grid; gap: 0.4rem; }
  label { font-size: var(--fs-sm); font-weight: var(--weight-bold); letter-spacing: 0.02em; }
  input, select, textarea {
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.75em 0.9em;
    width: 100%;
    resize: vertical;
  }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--color-copper);
  }
  select { appearance: none; cursor: pointer; }
  .gotcha { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .form-foot { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .form-status { margin: 0; font-size: var(--fs-sm); }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; }
  }
</style>
