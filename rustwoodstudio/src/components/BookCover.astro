---
// Book cover. Drop a real image at the `src` path and it takes over;
// until then, the forged CSS placeholder shows. If the image 404s it
// removes itself, revealing the placeholder again.
interface Props {
  src?: string;
  alt?: string;
}
const { src = "/img/singing-fundamentals.jpg", alt = "Singing Fundamentals cover" } = Astro.props;
---

<div class="cover-art">
  <img src={src} alt={alt} class="cover-img" loading="lazy" onerror="this.remove()" />
  <span class="cover-title">Singing<br />Fundamentals</span>
  <span class="cover-author">Aaron Ellis</span>
</div>

<style>
  .cover-art {
    position: relative;
    aspect-ratio: 2 / 3;
    width: 100%;
    max-width: 16rem;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--color-copper) 45%, var(--color-border));
    background:
      radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--color-copper) 30%, transparent), transparent 65%),
      linear-gradient(165deg, var(--color-surface-2), var(--color-bg-2));
    box-shadow: var(--shadow), var(--glow);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-4);
    text-align: center;
    overflow: hidden;
  }
  .cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
  }
  .cover-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    line-height: 1.15;
    margin-top: var(--space-5);
    color: var(--color-ember);
  }
  .cover-author {
    font-size: var(--fs-sm);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
