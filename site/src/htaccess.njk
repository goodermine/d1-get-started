# Generated by Eleventy. Static site for aaronellis.co.network.
# Uses ONLY mod_rewrite + DirectoryIndex (the directives WordPress itself relied
# on, so they're permitted by this host's AllowOverride) to avoid 500s.

# Serve the static index.html in preference to WordPress's index.php.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 301 redirects: preserve old WordPress URLs ---
  RewriteRule ^home/?$                      /                    [R=301,L]
  RewriteRule ^ai-workflow-build-sprint/?$  /real-estate-buddy/  [R=301,L]
  RewriteRule ^category/                    /articles/           [R=301,L]
  RewriteRule ^tag/                         /articles/           [R=301,L]
  RewriteRule ^author/                      /                    [R=301,L]

  # --- Retire WordPress: a static site needs no PHP ---
  # Block ALL php execution (wp-login, xmlrpc, wp-cron, index.php, and any
  # shell uploaded into wp-content). /wp-content/uploads/ media still serves
  # because it isn't a .php file.
  RewriteRule \.php$                        -                    [F,L]
  RewriteRule ^wp-admin(/|$)                -                    [F,L]
  RewriteRule ^wp-includes(/|$)             -                    [F,L]
  RewriteRule ^wp-json(/|$)                 -                    [F,L]
  RewriteRule ^(readme\.html|license\.txt)$ -                    [F,L]
</IfModule>
