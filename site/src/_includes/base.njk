<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.title %}{{ title | safe }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="/css/site.css">
  <meta name="theme-color" content="#061b1f">
</head>
<body>
  {% include "header.njk" %}
  <main>
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
  {% if '<form class="ae-resource-search"' in content %}<script src="/assets/resource-search.js"></script>{% endif %}
</body>
</html>
