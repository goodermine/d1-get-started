---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site.ts";

const deliverables = [
  { h: "Setup guide", p: "A clear, step-by-step guide to getting ChatGPT working for your day-to-day." },
  { h: "Prompt pack", p: "Ready-to-use prompts tuned for real-estate tasks and tone." },
  { h: "Workflow map", p: "A simple map of where AI fits into your existing process — and where it shouldn't." },
  { h: "Setup notes", p: "Personalised notes from your setup session so nothing gets lost." },
];
const tasks = [
  "Draft listing descriptions",
  "Reply to enquiry emails",
  "Summarise contracts & notes",
  "Social captions & posts",
  "Follow-up sequences",
  "Open-home checklists",
];
const steps = [
  { n: "1", h: "Quick brief", p: "You tell me how you work and what eats your time." },
  { n: "2", h: "Done-with-you setup", p: "We set ChatGPT up together, tuned to your workflow." },
  { n: "3", h: "Prompts & handover", p: "You leave with prompts, a workflow map, and notes you can keep using." },
];
---

<BaseLayout
  title="Real Estate Buddy"
  description="Real Estate Buddy — a done-with-you ChatGPT setup service for real estate agents. Beta, AUD $297."
>
  <PageHeader
    eyebrow="AI Builds · Beta"
    title="Real Estate Buddy"
    lead="A done-with-you ChatGPT setup for real estate agents — so the admin, drafting, and follow-ups take minutes, not hours."
  />

  <section class="section">
    <div class="container">
      <div class="offer card">
        <div>
          <span class="eyebrow">Beta offer</span>
          <p class="price">AUD $297</p>
          <p class="muted">Limited beta. Done-with-you setup — not unlimited consulting.</p>
        </div>
        <a href={`mailto:${site.email}?subject=Real%20Estate%20Buddy`} class="btn btn-primary">Enquire about the beta</a>
      </div>
    </div>
  </section>

  <section class="section who">
    <div class="container narrow">
      <h2>Who it helps</h2>
      <p class="muted">
        Agents who know AI could save them hours but haven't had the time to
        set it up properly — and want it tuned to how they actually work,
        without the hype.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What's included</h2>
      <div class="grid-4">
        {deliverables.map((d) => (
          <div class="card"><h3>{d.h}</h3><p class="muted">{d.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Tasks it handles</h2>
      <ul class="tasks">
        {tasks.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How it works</h2>
      <div class="grid-3">
        {steps.map((s) => (
          <div class="card step"><span class="step-n">{s.n}</span><h3>{s.h}</h3><p class="muted">{s.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="card compliance">
        <h3>Beta scope & compliance</h3>
        <p class="muted">
          You remain responsible for everything you publish and send. AI drafts
          are a starting point — always review for accuracy and compliance with
          your obligations. This is a focused setup service, not ongoing advice.
        </p>
      </div>
      <div class="cta-row">
        <a href={`mailto:${site.email}?subject=Real%20Estate%20Buddy`} class="btn btn-primary">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: var(--maxw-prose); }
  .offer { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  .price { font-family: var(--font-heading); font-size: var(--fs-2xl); color: var(--color-accent); margin: 0.2rem 0; }
  .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--space-4); }
  .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-4); }
  .grid-4 h3, .grid-3 h3 { font-size: var(--fs-lg); }
  .tasks { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: var(--space-2); }
  .tasks li { padding: 0.7rem 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .tasks li::before { content: "✓ "; color: var(--color-accent); font-weight: 700; }
  .step-n { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; background: var(--color-surface-2); color: var(--color-accent); font-weight: 700; margin-bottom: var(--space-2); }
  .compliance { border-color: var(--color-accent); border-style: dashed; }
  .cta-row { margin-top: var(--space-4); }
</style>
