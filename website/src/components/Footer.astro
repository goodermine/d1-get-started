---
import { nav } from "../data/nav.ts";
import { site } from "../data/site.ts";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="monogram">{site.monogram}</span>
      <div>
        <strong>{site.brand}</strong>
        <p class="muted tagline">{site.tagline}</p>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
  <div class="container footer-base">
    <span class="muted">© {year} {site.name}. All rights reserved.</span>
    <a href={`mailto:${site.email}`} class="muted">{site.email}</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    margin-top: var(--space-7);
    padding-block: var(--space-6) var(--space-4);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    justify-content: space-between;
    align-items: flex-start;
  }
  .footer-brand { display: flex; gap: 0.9rem; align-items: center; max-width: 22rem; }
  .footer-brand strong { font-size: var(--fs-base); }
  .tagline { margin: 0.2rem 0 0; font-size: var(--fs-sm); }
  .monogram {
    display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 10px;
    font-family: var(--font-heading); font-weight: 700; font-size: 1.3rem;
    color: var(--color-on-accent);
    background: linear-gradient(135deg, var(--color-accent-2), var(--color-accent));
    flex: none;
  }
  .footer-nav {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem;
    max-width: 30rem; justify-content: flex-end;
  }
  .footer-nav a { color: var(--color-muted); font-size: var(--fs-sm); }
  .footer-nav a:hover { color: var(--color-accent); }
  .footer-base {
    display: flex; flex-wrap: wrap; gap: var(--space-3);
    justify-content: space-between;
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-xs);
  }
</style>
